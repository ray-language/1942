// 1942 — the reactive music pump on std/audio: a fiber synthesizes WSG
// sub-steps and writes PCM straight to the device. Backpressure is the
// pacing: the output is opened with a small latency hint (LATENCY_MS), so
// audio.write parks once ~that much is queued and game events reach the ear
// promptly (measured on raylang 1.27.50, macOS: a 30 ms hint queues ~40 ms).
// Events arrive through a channel; a drain + close ends the fiber without
// clipping the tail. No device → silent game, nothing else changes. Lifted
// from rallyx, which proved the pacing.
import std/audio;
import wsg;

// Total queued between write and the speaker (std/audio accepts 20-1000).
const LATENCY_MS: int = 30;

pub struct Music {
    ch: Channel<int>,
    on: bool,
}

pub fn off() -> Music {
    let ch: Channel<int> = Channel.bounded(1);
    Music { ch: ch, on: false }
}

pub fn start() -> Music {
    let ch: Channel<int> = Channel.bounded(64);
    match (audio.open_latency(wsg.RATE, 1, LATENCY_MS)) {
        Result.Ok(h) => {
            spawn(fn() {
                pump(h, ch);
            });
            Music { ch: ch, on: true }
        },
        Result.Err(e) => {
            off()
        },
    }
}

pub fn send_event(m: Music, ev: int) {
    if (m.on) {
        send(m.ch, ev);
    }
}

pub fn stop(m: Music) {
    if (m.on) {
        send(m.ch, wsg.EV_STOP);
    }
}

fn pump(h: int, ch: Channel<int>) {
    let t = wsg.new_tracker();
    var running = true;
    while (running) {
        // Apply every queued event before synthesizing the next sub-step.
        while (running) {
            match (try_recv(ch)) {
                Received.Got(ev) => {
                    if (ev == wsg.EV_STOP) {
                        running = false;
                    } else {
                        wsg.apply(t, ev);
                    }
                },
                Received.Empty => {
                    break;
                },
                Received.Closed => {
                    running = false;
                },
            }
        }
        if (running) {
            // Parks while ~LATENCY_MS is queued: the device sets the tempo.
            match (audio.write(h, wsg.tick(t))) {
                Result.Ok(n) => {},
                Result.Err(dead) => {
                    running = false;
                },
            }
        }
    }
    audio.drain(h);
    close(h);
}
