// 1942 — a Namco-WSG-style synth, pure and clock-free, in the shape rallyx
// proved: 32-entry 4-bit wavetable voices plus an LFSR noise voice, read
// through phase accumulators and mixed to s16le mono. On top, a tracker: a
// 32-step looping march (an homage — the original 1942 score is Capcom's,
// this one is ours) with reactive states: the auto-cannon's chirp, an
// enemy's noise-burst explosion, the crash sweep when you are hit, a rising
// whoosh on the loop-the-loop, an ascending stage jingle, and the game-over
// descent — over a constant engine drone. The music fiber owns the clock;
// everything here is deterministic, so the score is testable byte by byte.

pub const RATE: int = 22050;

pub const STEP_MS: int = 110;

pub const SAMPLES_PER_STEP: int = 2425;

// A tick renders HALF a musical step: events picked up between ticks land on
// the ear a sub-step (55 ms) sooner.
pub const SUB_MS: int = 55;

pub const TONE: int = 0;

pub const BUZZ: int = 1;

pub const NOISE: int = 2;

