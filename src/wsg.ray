    ]
}

// Integer Hz for a MIDI note (C4=60 … A4=69=440). Good enough for chip music.
pub fn freq_of(midi: int) -> int {
    let base = [262, 277, 294, 311, 330, 349, 370, 392, 415, 440, 466, 494];
    let f = base[midi % 12];
    let oct = midi / 12 - 5;
    if (oct >= 0) { f << oct } else { f >> 0 - oct }
}

